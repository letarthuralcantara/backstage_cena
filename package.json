{
  "name": "backstage_cena",
  "version": "1.0.0",
  "type": "module",
  "description": "Backstage Cena — plataforma para músicos",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "setup": "npm run prisma:generate && npx prisma migrate deploy && npm run seed",
    "reset": "npm run prisma:generate && npx prisma migrate reset --force && npm run seed",
    "db:load": "npm run seed",
    "db:reload": "npm run reset"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-libsql": "^7.8.0",
    "argon2": "^0.45.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.2.0",
    "nodemailer": "^6.9.15",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@prisma/client": "^7.8.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^6.4.16",
    "@types/node": "^22.0.0",
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "typescript": "^5.5.0"
  }
}
