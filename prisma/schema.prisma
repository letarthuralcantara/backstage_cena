generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Usuario {
  id_usuario        Int      @id @default(autoincrement())
  nome_completo     String
  nome_artistico    String
  email             String   @unique
  senha             String
  telefone          String?
  cidade            String?
  estado            String?
  bairro            String?
  area_atuacao      String?
  anos_experiencia  Int      @default(0)
  biografia         String?
  cadastro_completo Int      @default(0)
  redes_sociais     String?
  status            String   @default("disponivel") // disponivel, ocupado, nao_perturbe, invisivel

  // HMAC-SHA256 do código, chaveado por RESET_CODE_SECRET (fallback JWT_SECRET).
  // O valor original só vai por e-mail e o HMAC é apagado ao ser usado.
  codigo_reset_senha     String?
  codigo_reset_expira_em DateTime?

  instrumentos     UsuarioInstrumento[]
  generos          UsuarioGenero[]
  daws             UsuarioDaw[]
  disponibilidades UsuarioDisponibilidade[]
  configuracoes    ConfiguracaoUsuario?
  imagem           ImagemUsuario?
  postagens        Postagem[]
  tweets           Tweet[]
  workOns          WorkOn[]        @relation("WorkOnDono")
  workOnMembros    WorkOnMembro[]
  workOnVersoes    WorkOnVersao[]   @relation("WorkOnVersaoAutor")
  workOnTarefas    WorkOnTarefa[]   @relation("WorkOnTarefaResponsavel")
  workOnFotos      WorkOnFoto[]     @relation("WorkOnFotoAutor")
  conexaoMusica    ConexaoMusica?
  clubesCriados    Clube[]          @relation("ClubeCriador")
  clubes           ClubeMembro[]
  mensagensClube   ClubeMensagem[]

  @@map("usuario")
}

model Postagem {
  id_postagem Int      @id @default(autoincrement())
  id_usuario  Int
  titulo      String? // nome/título opcional dado pelo usuário à prévia
  audio_url   String // caminho do arquivo de áudio completo
  inicio_seg  Int      @default(0) // segundo em que a prévia começa a tocar
  duracao_seg Int      @default(30) // duração da prévia, em segundos
  criado_em   DateTime @default(now())
  expira_em   DateTime // criado_em + 24h, calculado na criação

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)

  @@map("postagem")
}

// O banco guarda só o caminho público do avatar; o arquivo vive em public/uploads/avatars.
// id_usuario @unique => no máximo uma imagem por usuário.
model ImagemUsuario {
  id_imagem  Int    @id @default(autoincrement())
  id_usuario Int    @unique
  caminho    String

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)

  @@map("imagem_usuario")
}

model WorkOn {
  id_workon       Int       @id @default(autoincrement())
  id_dono         Int
  titulo          String
  descricao       String?
  tipo            String    @default("outro")
  status          String    @default("ideia")
  visibilidade    String    @default("publico")
  token_convite   String?   @unique
  icone           String?
  capa            String?
  daw             String?
  genero          String?
  prazo           DateTime?
  notas           String?
  criado_em       DateTime  @default(now())
  atualizado_em   DateTime  @updatedAt

  dono            Usuario   @relation("WorkOnDono", fields: [id_dono], references: [id_usuario], onDelete: Cascade)
  membros         WorkOnMembro[]
  faixas          WorkOnFaixa[]
  tarefas         WorkOnTarefa[]
  fotos           WorkOnFoto[]

  @@index([id_dono])
  @@index([visibilidade, atualizado_em])
  @@map("work_on")
}

model WorkOnMembro {
  id_workon Int
  id_usuario Int
  papel String @default("ouvinte")
  entrou_em DateTime @default(now())

  workOn WorkOn @relation(fields: [id_workon], references: [id_workon], onDelete: Cascade)
  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)

  @@id([id_workon, id_usuario])
  @@index([id_workon])
  @@index([id_usuario])
  @@map("work_on_membro")
}

model WorkOnFaixa {
  id_faixa  Int      @id @default(autoincrement())
  id_workon Int
  titulo    String
  ordem     Int
  bpm       Int?
  tom       String?
  notas     String?
  criado_em DateTime @default(now())

  workOn    WorkOn         @relation(fields: [id_workon], references: [id_workon], onDelete: Cascade)
  versoes   WorkOnVersao[]

  @@index([id_workon])
  @@map("work_on_faixa")
}

model WorkOnVersao {
  id_versao    Int      @id @default(autoincrement())
  id_faixa     Int
  numero       Int
  rotulo       String?
  observacao   String?
  arquivo      String
  mime         String
  tamanho_bytes Int
  id_autor     Int
  criado_em    DateTime @default(now())

  faixa        WorkOnFaixa @relation(fields: [id_faixa], references: [id_faixa], onDelete: Cascade)
  autor        Usuario     @relation("WorkOnVersaoAutor", fields: [id_autor], references: [id_usuario], onDelete: Cascade)

  @@unique([id_faixa, numero])
  @@index([id_faixa])
  @@index([id_autor])
  @@map("work_on_versao")
}

model WorkOnTarefa {
  id_tarefa      Int       @id @default(autoincrement())
  id_workon      Int
  texto          String
  feita          Boolean   @default(false)
  prazo          DateTime?
  ordem          Int       @default(0)
  id_responsavel Int?

  workOn         WorkOn          @relation(fields: [id_workon], references: [id_workon], onDelete: Cascade)
  responsavel    Usuario?        @relation("WorkOnTarefaResponsavel", fields: [id_responsavel], references: [id_usuario], onDelete: SetNull)

  @@index([id_workon])
  @@index([id_responsavel])
  @@map("work_on_tarefa")
}

model WorkOnFoto {
  id_foto    Int      @id @default(autoincrement())
  id_workon  Int
  caminho    String
  legenda    String?
  ordem      Int      @default(0)
  id_autor   Int

  workOn     WorkOn   @relation(fields: [id_workon], references: [id_workon], onDelete: Cascade)
  autor      Usuario  @relation("WorkOnFotoAutor", fields: [id_autor], references: [id_usuario], onDelete: Cascade)

  @@index([id_workon])
  @@index([id_autor])
  @@map("work_on_foto")
}

model ConexaoMusica {
  id_conexao           Int      @id @default(autoincrement())
  id_usuario           Int      @unique
  provedor             String
  id_externo           String
  nome_exibicao        String
  refresh_token_cifrado String?
  visibilidade         String   @default("publico")
  criado_em            DateTime @default(now())
  atualizado_em        DateTime @updatedAt

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)

  @@index([visibilidade])
  @@map("conexao_musica")
}

// ── Clubes ────────────────────────────────────────────────────────────────────
// Um clube é um grupo ligado a uma "tag" de afinidade (gênero, instrumento ou DAW)
// ou "geral". id_criador nulo = clube padrão, criado a partir do catálogo.
model Clube {
  id_clube   Int      @id @default(autoincrement())
  nome       String   @unique
  descricao  String?
  tipo       String   @default("geral") // genero, instrumento, daw, geral
  tag        String?
  imagem     String?
  id_criador Int?
  criado_em  DateTime @default(now())

  criador   Usuario?        @relation("ClubeCriador", fields: [id_criador], references: [id_usuario], onDelete: SetNull)
  membros   ClubeMembro[]
  mensagens ClubeMensagem[]

  @@map("clube")
}

model ClubeMembro {
  id_clube   Int
  id_usuario Int
  papel      String   @default("membro") // dono, membro
  entrou_em  DateTime @default(now())

  clube   Clube   @relation(fields: [id_clube], references: [id_clube], onDelete: Cascade)
  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)

  @@id([id_clube, id_usuario])
  @@index([id_usuario])
  @@map("clube_membro")
}

model ClubeMensagem {
  id_mensagem Int      @id @default(autoincrement())
  id_clube    Int
  id_usuario  Int
  texto       String
  criado_em   DateTime @default(now())

  clube   Clube   @relation(fields: [id_clube], references: [id_clube], onDelete: Cascade)
  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)

  @@index([id_clube, id_mensagem])
  @@map("clube_mensagem")
}

model Disponibilidade {
  id_disponibilidade Int                      @id @default(autoincrement())
  descricao          String                   @unique
  usuarios           UsuarioDisponibilidade[]

  @@map("disponibilidade")
}

model UsuarioDisponibilidade {
  id_usuario         Int
  id_disponibilidade Int

  usuario         Usuario         @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)
  disponibilidade Disponibilidade @relation(fields: [id_disponibilidade], references: [id_disponibilidade], onDelete: Cascade)

  @@id([id_usuario, id_disponibilidade])
  @@map("usuario_disponibilidade")
}

model ConfiguracaoUsuario {
  id_config             Int     @id @default(autoincrement())
  id_usuario            Int     @unique
  mostrar_email         Int     @default(1)
  mostrar_telefone      Int     @default(0)
  mostrar_redes_sociais Int     @default(1)
  perfil_publico        Int     @default(1)

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)

  @@map("configuracoes_usuario")
}

model Instrumento {
  id_instrumento Int                  @id @default(autoincrement())
  nome           String               @unique
  usuarios       UsuarioInstrumento[]

  @@map("instrumento")
}

model Genero {
  id_genero Int             @id @default(autoincrement())
  nome      String          @unique
  usuarios  UsuarioGenero[]

  @@map("genero")
}

model Daw {
  id_daw   Int          @id @default(autoincrement())
  nome     String       @unique
  usuarios UsuarioDaw[]

  @@map("daw")
}

model UsuarioInstrumento {
  id_usuario     Int
  id_instrumento Int
  principal      Int @default(0)

  usuario     Usuario     @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)
  instrumento Instrumento @relation(fields: [id_instrumento], references: [id_instrumento], onDelete: Cascade)

  @@id([id_usuario, id_instrumento])
  @@map("usuario_instrumento")
}

model UsuarioGenero {
  id_usuario  Int
  id_genero   Int
  preferencia Int @default(1)

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)
  genero  Genero  @relation(fields: [id_genero], references: [id_genero], onDelete: Cascade)

  @@id([id_usuario, id_genero])
  @@map("usuario_genero")
}

model UsuarioDaw {
  id_usuario Int
  id_daw     Int

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)
  daw     Daw     @relation(fields: [id_daw], references: [id_daw], onDelete: Cascade)

  @@id([id_usuario, id_daw])
  @@map("usuario_daw")
}

model Tweet {
  id_tweet   Int       @id @default(autoincrement())
  id_usuario Int
  texto      String
  imagem     String?
  criado_em  DateTime  @default(now())
  expira_em  DateTime? // null = permanece pra sempre; preenchido = some quando passar dessa data

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)

  @@map("tweet")
}